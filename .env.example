# --- Provider de IA (sem chave = embedder local + LLM simulado, 100% offline) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# OFFLINE=true

# --- Persistência ---
DB_FILE=data/knowledge.db

# --- Busca híbrida ---
SIMILARITY_THRESHOLD=0.7
TOP_K=4
# Peso do score vetorial no score híbrido (o restante vai para o score lexical)
VECTOR_WEIGHT=0.5
CHUNK_SIZE=450

DEBUG=false
